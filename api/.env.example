DB_HOST=localhost
DB_PORT=3306
DB_NAME=mechabot
DB_USER=root
DB_PASSWORD=
UPLOAD_DIR=uploads

# CORS Origins (comma-separated, leave empty for same-origin or localhost)
CORS_ORIGINS=

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=MechaBot Platform

# Public website URL
APP_URL=http://localhost:8080

# Set true to require email verification before login
VERIFY_EMAIL_ENABLED=false
